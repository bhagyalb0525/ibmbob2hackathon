# ==============================================
# regen — Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================

# Server Ports
PORT=3000
DEMO_SERVICE_PORT=3001
NODE_ENV=development

# Immune Memory Engine Settings
IMMUNE_SIMILARITY_THRESHOLD=0.85
IMMUNE_STORE_PATH=./memory/seed_memory.json

# Pipeline & Agent Configuration
TREATMENT_MIN_CONFIDENCE=0.80
PIPELINE_TIMEOUT_MS=90000

# Telemetry & Notification Integrations (Mock / Demo)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/WEBHOOK/URL
GITHUB_REPO=your-org/regen-demo-service

# IBM Bob IDE / Agent Credentials (if running via API interface)
IBM_BOB_API_KEY=your_bob_api_key_or_session_token_here